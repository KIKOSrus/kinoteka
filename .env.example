# Скопируйте этот файл в .env и при необходимости поправьте значения.
DATABASE_URL=postgresql+psycopg2://kinoteka:kinoteka@localhost:5432/kinoteka

# JWT (ЛР№2). В боевой среде обязательно замените SECRET_KEY!
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
